{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "notice-kinds.json",
  "title": "Every notice kind is journaled per chat, persisted across restarts, and replayed to every attach. The enum documents the known kind vocabulary.",
  "$defs": {
    "DurableNoticeKind": {
      "type": "string",
      "enum": [
        "retry_fallback_applied",
        "retry_fallback_reverted",
        "retry_fallback_succeeded",
        "retry_fallback_exhausted",
        "server_fallback_aborted",
        "high_reasoning_warning",
        "auto_retry_start",
        "auto_retry_end",
        "compaction_error",
        "queue_delivery_uncertain",
        "extension_notify"
      ]
    }
  }
}
